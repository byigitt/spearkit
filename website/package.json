{
  "name": "spearkit-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "convert-docs": "node scripts/convert-docs.mjs",
    "generate-api": "node scripts/generate-api.mjs",
    "generate-docs": "npm run convert-docs && npm run generate-api",
    "predev": "npm run generate-docs",
    "prebuild": "npm run generate-docs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "^16.9.3",
    "fumadocs-mdx": "^15.0.10",
    "fumadocs-ui": "^16.9.3",
    "geist": "^1.7.1",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
